{#- Переїзд, крок 1: додати новий майданчик поруч зі старим (pending)
    і запустити автовідкат. Старий тунель не чіпаємо, поки новий не підніметься. -#}
{% from "mikrotik/_site.rsc.j2" import site_block, remove_tagged %}
# fleet move: {{ robot.name }} {{ old_site }} -> {{ new.name }} (pending, auto-rollback in {{ rollback_min }} min)

# Leftovers of a previous failed attempt
{{ remove_tagged(new.tag) }}
/system script remove [find name="fleet-rollback-{{ new.name }}"]

{{ site_block(new) }}

/system script add name="fleet-rollback-{{ new.name }}" source={
{{ remove_tagged(new.tag) | indent(2, true) }}
  :log warning "fleet: move to {{ new.name }} not confirmed, rolled back"
}
:execute script="{ :delay {{ rollback_min }}m; /system script run [find name=\"fleet-rollback-{{ new.name }}\"] }"
:log info "fleet: move to {{ new.name }} started"
