{#- Полный конфиг MikroTik робота. Применяется на чистое устройство:
    netinstall (Configure script / netinstall-cli -s) или
    /system reset-configuration no-defaults=yes run-after-reset=<файл>.
    Весь вывод — только ASCII. -#}
{% from "mikrotik/_site.rsc.j2" import site_block %}
# fleet: {{ robot.name }} (id {{ robot.id }}), site {{ site.name }}, slot {{ slot }}
# fingerprint {{ fingerprint }}
# Generated by fleet - do not edit on the device. Change inventory/templates and re-render.

# Interfaces appear with a delay at first boot after netinstall
{
  :local i 0
  :while (([:len [/interface find name="{{ platform.wan.interface }}"]] = 0) && ($i < 60)) do={ :delay 1s; :set i ($i + 1) }
  :delay 5s
}

/system identity set name="{{ robot.name }}"
/user set [find name=admin] password="{{ mikrotik_password }}"

# --- Robot LAN: identical on every robot ---
/interface bridge add name=br-lan comment="fleet"
/interface bridge port
add bridge=br-lan interface={{ platform.ports.fc }} comment="fleet: fc"
add bridge=br-lan interface={{ platform.ports.cam1 }} comment="fleet: cam1"
add bridge=br-lan interface={{ platform.ports.cam2 }} comment="fleet: cam2"
add bridge=br-lan interface={{ platform.ports.bench }} comment="fleet: bench"
/ip address add address={{ lan.router }}/24 interface=br-lan comment="fleet"
/ip pool add name=fleet-lan ranges=192.168.88.100-192.168.88.199
/ip dhcp-server add name=fleet-lan interface=br-lan address-pool=fleet-lan disabled=no
/ip dhcp-server network add address={{ lan.net }} gateway={{ lan.router }} comment="fleet"
/interface list add name=fleet-lan
/interface list add name=fleet-sites
/interface list member add list=fleet-lan interface=br-lan

# --- WAN ---
{% if platform.wan.type == "lte" %}
/interface lte apn add name=fleet apn="{{ platform.wan.apn }}"
/interface lte set [find name="{{ platform.wan.interface }}"] apn-profiles=fleet
{% else %}
/ip dhcp-client add interface={{ platform.wan.interface }} disabled=no comment="fleet: wan"
{% endif %}

# --- Site tunnel: {{ site.name }} ---
{{ site_block(site) }}

{% if svc %}
# --- Service tunnel: management only (ssh, winbox), no video or telemetry ---
/interface wireguard add name={{ svc.iface }} listen-port={{ svc.listen_port }} mtu={{ svc.mtu }} private-key="{{ svc.private_key }}" comment="fleet-svc"
/interface wireguard peers add interface={{ svc.iface }} public-key="{{ svc.server_pubkey }}" endpoint-address={{ svc.endpoint_host }} endpoint-port={{ svc.endpoint_port }} allowed-address={{ svc.allowed }} persistent-keepalive=25s comment="fleet-svc"
/ip address add address={{ svc.robot_ip }}/{{ svc.prefix }} interface={{ svc.iface }} comment="fleet-svc"
{% endif %}

# --- Firewall ---
/ip firewall filter
add chain=input action=accept connection-state=established,related,untracked comment="fleet"
add chain=input action=drop connection-state=invalid comment="fleet"
add chain=input action=accept protocol=icmp comment="fleet"
add chain=input action=accept in-interface-list=fleet-lan comment="fleet: bench and LAN"
add chain=input action=accept in-interface-list=fleet-sites src-address-list=fleet-mgmt protocol=tcp dst-port=22 comment="fleet: ssh from site server"
{% if svc %}
add chain=input action=accept in-interface={{ svc.iface }} protocol=tcp dst-port=22,8291 comment="fleet: service tunnel"
{% endif %}
add chain=input action=drop comment="fleet: drop"
add chain=forward action=accept connection-state=established,related,untracked comment="fleet"
add chain=forward action=drop connection-state=invalid comment="fleet"
add chain=forward action=accept in-interface-list=fleet-sites src-address-list=fleet-sources dst-address={{ lan.fc }} protocol=tcp dst-port={{ mav_port }} comment="fleet: mavlink"
add chain=forward action=accept in-interface-list=fleet-sites src-address-list=fleet-sources dst-address={{ lan.cam1 }}-{{ lan.cam2 }} protocol=tcp dst-port=554 comment="fleet: rtsp"
add chain=forward action=accept in-interface-list=fleet-lan out-interface-list=fleet-lan comment="fleet: LAN routing (bench)"
add chain=forward action=drop comment="fleet: drop - cameras and FC have no internet"

# --- Services and hardening ---
/ip service
set telnet disabled=yes
set ftp disabled=yes
set www disabled=yes
set www-ssl disabled=yes
set api disabled=yes
set api-ssl disabled=yes
set ssh disabled=no
set winbox disabled=no
/ip ssh set strong-crypto=yes
/tool mac-server set allowed-interface-list=fleet-lan
/tool mac-server mac-winbox set allowed-interface-list=fleet-lan
/ip neighbor discovery-settings set discover-interface-list=fleet-lan

# WireGuard needs a sane clock after reboot
/system ntp client set enabled=yes
/system ntp client servers add address=pool.ntp.org

/system script add name=fleet-version source="# {{ fingerprint }}" comment="fleet {{ fingerprint }}"
:log info "fleet: config {{ fingerprint }} applied"
