# fleet: stack of site {{ site.name }} - generated, do not edit.
# host network: services bind to the site's tunnel address {{ server_ip }}
# and reach UGVs through the WireGuard interface of the host.
# Both services re-read config/ on change, so a deploy does not drop operators.
name: fleet-{{ site.name }}
services:
  mediamtx:
    image: bluenviron/mediamtx:{{ mediamtx_version }}
    command: /config/mediamtx.yml
    network_mode: host
    restart: unless-stopped
    volumes:
      - ./config:/config:ro

  arbiter:
    build: ./arbiter
    network_mode: host
    restart: unless-stopped
    volumes:
      - ./config:/config:ro
      - ./state:/state
