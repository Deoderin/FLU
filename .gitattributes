# Скрипти й шаблони йдуть на Linux і RouterOS: лише LF, навіть під час checkout у Windows
*.sh   text eol=lf
*.j2   text eol=lf
*.rsc  text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.html text eol=lf
Dockerfile text eol=lf

# Установник для Windows: cmd надійно працює лише з CRLF
*.cmd  text eol=crlf
*.ps1  text eol=crlf
